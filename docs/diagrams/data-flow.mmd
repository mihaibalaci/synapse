flowchart LR
    subgraph Capture["Capture Layer"]
        MCP[MCP Server]
        SDK_PY[Python SDK]
        SDK_JS[JavaScript SDK]
        CLI[CLI]
        GIT[Git Webhooks]
        SLACK[Slack Bot]
        DOCS[Document Upload<br/>PDF/Image/Diagram]
    end

    subgraph API["API Server (Go)"]
        AUTH[Auth Module<br/>Login/Refresh/OIDC]
        RATE[Rate Limiter<br/>Per-role tiers]
        CAP[Capture Handler]
        GIT_CAP[Git Capture Handler]
        DOC_CAP[Document Capture<br/>Multi-modal Processing]
        SEARCH[Search Engine<br/>4-signal hybrid]
        TEMPORAL[Temporal Queries<br/>Point-in-time/Evolution]
        REFLECT[Reflect/Learning Loop]
        FACTS[Facts API]
        ADMIN[Admin Routes]
        METRICS[Prometheus metrics]
        WEBHOOKS[Webhook Emitter]
        SHARED[Shared Context<br/>Cross-agent dedup]
        COMPRESS[Context Compression<br/>30-60% token savings]
        COST[Token Cost Tracker]
    end

    subgraph Storage["Storage Layer"]
        PG[(PostgreSQL 16<br/>pgvector + FTS<br/>Temporal Versioning)]
        REDIS[(Redis 7<br/>Queues + Cache)]
        S3[(S3/MinIO<br/>Raw Objects)]
    end

    subgraph Worker["Worker Process"]
        INGEST[Ingestion Pipeline]
        SEG[Segment]
        EMBED[Embed 768d]
        EXTRACT[Extract Facts]
        DEDUP[Cross-session Dedup]
        GRAPH[Graph Population]
        CONTRA[Contradiction Detection]
        TEMP_IDX[Temporal Indexer<br/>Version Chains]
        INDEX[Search Index]
        COMPACT[Auto-Compaction<br/>LLM Summarization]
        CONF_CAL[Confidence Calibration]
    end

    subgraph Multimodal["Multi-Modal Processing"]
        PDF[PDF Extraction]
        OCR[OCR/Vision LLM]
        DIAGRAM[Diagram Parsing<br/>SVG/draw.io]
        CODE[AST-aware Chunking]
    end

    subgraph Intelligence["Intelligence"]
        LLM[LLM Provider<br/>Ollama/OpenAI/Anthropic]
        VISION[Vision Model<br/>llava/gpt-4o/claude]
    end

    subgraph Solo["Solo Mode (optional)"]
        SOLO_API[Solo API :3333]
        FILE_STORE[FileStore<br/>~/.synapse/objects/]
        MEM_CACHE[In-Memory Cache]
        VEC_IDX[Vector Index<br/>Brute-force cosine]
        TXT_IDX[Text Index<br/>TF-IDF]
    end

    %% Capture flows
    MCP --> CAP
    SDK_PY --> CAP
    SDK_JS --> CAP
    CLI --> CAP
    GIT --> GIT_CAP
    SLACK --> CAP
    DOCS --> DOC_CAP

    %% Document processing
    DOC_CAP --> PDF
    DOC_CAP --> OCR
    DOC_CAP --> DIAGRAM
    DOC_CAP --> CODE
    OCR --> VISION
    PDF --> CAP
    DIAGRAM --> CAP
    CODE --> CAP

    %% API internals
    CAP --> S3
    CAP --> REDIS
    GIT_CAP --> S3
    GIT_CAP --> REDIS
    AUTH --> PG
    SEARCH --> PG
    SEARCH --> REDIS
    TEMPORAL --> PG
    REFLECT --> SEARCH
    REFLECT --> COMPRESS
    COMPRESS --> LLM
    FACTS --> PG
    ADMIN --> PG
    WEBHOOKS -.->|async| EXT_HOOK[External Systems]

    %% Worker pipeline
    REDIS -->|BRPOP| INGEST
    INGEST --> SEG --> EMBED --> EXTRACT --> DEDUP --> GRAPH --> CONTRA --> TEMP_IDX --> INDEX
    EMBED --> PG
    EXTRACT --> PG
    DEDUP --> PG
    GRAPH --> PG
    CONTRA --> PG
    TEMP_IDX --> PG
    INDEX --> PG
    COMPACT --> COMPRESS
    COMPACT --> PG
    CONF_CAL --> PG
    EXTRACT -.-> WEBHOOKS
    CONTRA -.-> WEBHOOKS

    %% Solo mode (self-contained)
    SOLO_API --> FILE_STORE
    SOLO_API --> MEM_CACHE
    SOLO_API --> VEC_IDX
    SOLO_API --> TXT_IDX
