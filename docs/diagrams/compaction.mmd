flowchart TD
    subgraph Trigger["Trigger"]
        TIMER[Worker Timer<br/>Every 6 hours]
        CLI_CMD[synapse compact<br/>Manual]
        CRON[Kubernetes CronJob]
    end

    subgraph Level1["Level 1: Conversations"]
        CONV_FIND[Group sessions by conversation_id<br/>≥2 batches, newest >14 days old]
        CONV_LOAD[Load active chunks across batches<br/>chronological order]
    end

    subgraph Level2["Level 2: Standalone Sessions"]
        FIND[Find sessions >14 days old<br/>not part of a multi-batch conversation]
        FILTER[Filter: ≥3 active chunks<br/>No existing summary]
    end

    subgraph Level3["Level 3: Topics"]
        TOPIC_SEED[Summaries >28 days old<br/>oldest first]
        TOPIC_NN[Nearest neighbors<br/>cosine ≥0.82]
        TOPIC_SPAN[Require ≥2 distinct conversations]
    end

    subgraph Summarization["LLM Summarization"]
        BUILD[Build prompt from chunks<br/>12K chars, equal share per member]
        CALL_LLM[Call LLM<br/>Ollama/OpenAI/Anthropic<br/>prompt per level]
        VALIDATE[Validate non-empty summary]
    end

    subgraph Persistence["Atomic Persistence"]
        EMBED_SUM[Embed summary (768d)]
        INSERT[INSERT summary chunk<br/>type=summary/conversation_summary/topic_summary<br/>member_chunk_ids records lineage]
        ARCHIVE[UPDATE member chunks<br/>confidence=archived]
        TX[PostgreSQL Transaction]
    end

    subgraph Contradiction["Contradiction Scan"]
        SCAN[Recent facts (7 days)]
        COSINE[Embedding cosine >0.85]
        ENTITY_EQ[Identical entity sets]
        SUPERSEDE[Mark older fact superseded]
    end

    subgraph Confidence["Confidence Calibration"]
        DECAY[Fact decay: 90-day half-life]
        BOOST[Chunk boost: high usage]
        WEAKEN[Chunk decay: zero usage >60d]
    end

    TIMER --> CONV_FIND
    CLI_CMD --> CONV_FIND
    CRON --> CONV_FIND
    CONV_FIND --> CONV_LOAD --> BUILD
    CONV_LOAD -.->|then| FIND
    FIND --> FILTER --> BUILD
    FILTER -.->|then| TOPIC_SEED
    TOPIC_SEED --> TOPIC_NN --> TOPIC_SPAN --> BUILD
    BUILD --> CALL_LLM --> VALIDATE
    VALIDATE --> EMBED_SUM --> TX
    TX --> INSERT
    TX --> ARCHIVE

    TIMER --> SCAN
    SCAN --> COSINE --> ENTITY_EQ --> SUPERSEDE

    TIMER --> DECAY
    TIMER --> BOOST
    TIMER --> WEAKEN
