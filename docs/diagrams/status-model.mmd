stateDiagram-v2
    [*] --> processing: Capture accepted
    processing --> searchable: Worker pipeline complete
    processing --> failed: Fatal error (after retries)
    processing --> processing: Reaper recovery

    state searchable {
        [*] --> active
        active --> compacted: Auto-compaction (>14 days)
        active --> archived: Manual archive / dedup
        compacted --> archived: Further compaction
    }

    failed --> processing: Dead-letter retry

    state FactLifecycle {
        [*] --> valid
        valid --> superseded: Contradiction detected
        valid --> superseded: Manual supersession
        valid --> decayed: Confidence <0.3 (unused)
    }

    state UserSession {
        [*] --> authenticated: Login / Refresh
        authenticated --> expired: Access token TTL (15 min)
        expired --> authenticated: Refresh rotation
        authenticated --> revoked: Logout / Disable / Replay
        revoked --> [*]
    }
