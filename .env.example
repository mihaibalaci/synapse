# Copy to .env for local development. See infra/docker/.env.example for full docs.
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_context_store
REDIS_URL=redis://localhost:6379
S3_BUCKET=ai-context-store-raw
S3_ENDPOINT=http://localhost:9000
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
OPENSEARCH_URL=http://localhost:9200
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
LLM_PROVIDER=claude
QUEUE_CONCURRENCY=5
