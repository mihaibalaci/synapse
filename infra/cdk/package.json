{
  "name": "recall-infra",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "synth": "cdk synth",
    "deploy:dev": "cdk deploy --all --context stage=dev --require-approval never",
    "deploy:prod": "cdk deploy --all --context stage=prod",
    "diff": "cdk diff --all",
    "destroy:dev": "cdk destroy --all --context stage=dev --force"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.0",
    "aws-cdk": "^2.150.0"
  }
}
