FROM node:20.19.1-alpine3.21 AS builder
WORKDIR /app
COPY . .
RUN npm ci --prefer-offline
ARG NEXT_PUBLIC_API_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build --workspace @recall/dashboard

FROM node:20.19.1-alpine3.21 AS production
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci --prefer-offline --omit=dev && npm cache clean --force
COPY --from=builder /app/packages/dashboard/.next ./packages/dashboard/.next
RUN addgroup -g 1001 -S appuser && adduser -S appuser -u 1001 -G appuser && chown -R appuser:appuser /app
USER appuser
WORKDIR /app/packages/dashboard
ENV NODE_ENV=production PORT=3100 HOSTNAME=0.0.0.0
EXPOSE 3100
CMD ["../../node_modules/.bin/next", "start", "--port", "3100", "--hostname", "0.0.0.0"]
