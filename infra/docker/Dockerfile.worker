FROM node:20.19.1-alpine3.21 AS builder
WORKDIR /app
COPY . .
RUN npm ci --prefer-offline && npm run build:core

FROM node:20.19.1-alpine3.21 AS production
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci --prefer-offline --omit=dev && npm cache clean --force
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/migrations ./migrations
RUN addgroup -g 1001 -S appuser && adduser -S appuser -u 1001 -G appuser
USER appuser
EXPOSE 3001
ENV NODE_ENV=production WORKER_HEALTH_PORT=3001
CMD ["node", "dist/worker-entry.js"]
