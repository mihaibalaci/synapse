# ─── AI Context Store — Local Development Environment Variables ──────────────
# Copy this file to .env and fill in your API keys.
# docker-compose.yml services use their own defaults; these are for the app.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_context_store

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── S3 / MinIO ─────────────────────────────────────────────────────────────
S3_BUCKET=ai-context-store-raw
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000

# ─── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ─── OpenSearch ──────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ─── Embedding ───────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# For production embedding (uncomment and fill):
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ─── LLM (for knowledge extraction) ─────────────────────────────────────────
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-20250514

# For production LLM (uncomment and fill):
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Auth ────────────────────────────────────────────────────────────────────
AUTH_ISSUER=https://auth.company.com
AUTH_AUDIENCE=ai-context-store

# ─── Queue ───────────────────────────────────────────────────────────────────
QUEUE_CONCURRENCY=5

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
