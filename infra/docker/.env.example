# Copy to the repository root as .env before sharing the local stack.
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=3000
ADMIN_PORT=8080
# Replace all development credentials before exposing this stack.
AUTH_ISSUER=https://auth.synapse.local
AUTH_AUDIENCE=synapse
AUTH_JWT_SECRET=synapse-local-development-secret-change-before-sharing
WORKER_CONCURRENCY=5
LOG_LEVEL=info
