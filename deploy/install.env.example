# Copy to a root-readable file (chmod 600) and fill only what you need.
# This file is sourced by deploy/install.sh; only use trusted configuration.
# Every component supports: install, external, or skip.
POSTGRES_ACTION=install
REDIS_ACTION=install
S3_ACTION=install
EMBEDDING_ACTION=install
LLM_ACTION=external
API_ACTION=install
WORKER_ACTION=install
UI_ACTION=install
NGINX_ACTION=install

# PostgreSQL. DATABASE_URL overrides the individual external fields.
POSTGRES_MAJOR=16
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=synapse
PG_USER=synapse_app
PG_PASSWORD=
DATABASE_URL=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# S3 / MinIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=synapse-raw
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MINIO_CONSOLE_PORT=9001
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MC_VERSION=RELEASE.2025-04-16T18-13-26Z

# Embeddings: install provisions Ollama and pulls this 768-d model.
EMBEDDING_PROVIDER=ollama
EMBEDDING_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_NUM_THREADS=4
OLLAMA_VERSION=0.32.5

# Synthesis LLM. For external, set provider to ollama/openai/anthropic/none.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# API and worker
SYNAPSE_BINARY=
API_PORT=3000
API_HOST=127.0.0.1
LOG_LEVEL=info

# Worker Performance Tuning
# WORKER_CONCURRENCY: parallel ingestion pipelines (goroutines).
# Each pipeline handles one session: segment → embed → facts → dedup → graph → index.
# The bottleneck is embedding (~600ms CPU, ~20ms GPU per call).
#   CPU-only Ollama:  4–8 workers (embedding saturates beyond 6–8)
#   GPU Ollama:       8–16 workers (GPU handles parallel inference)
#   Remote/fast embed: 16–32 workers (network latency is the ceiling)
WORKER_CONCURRENCY=4

# EMBEDDING_NUM_THREADS: CPU threads Ollama uses per embedding call.
# Must match allocated cores (not host total). In LXC/containers, set to
# the number of cores the container actually has. Default 4.
# Too high = thread thrashing and slower inference.
EMBEDDING_NUM_THREADS=4
AUTH_ISSUER=https://auth.synapse.local
AUTH_AUDIENCE=synapse
AUTH_JWT_SECRET=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Flutter web build. Empty means packages/admin-ui/build/web in this checkout.
ADMIN_UI_SOURCE=
ADMIN_PORT=8080
SERVER_NAME=_

# Session configuration for the built-in login system.
# AUTH_COOKIE_SECURE should be false for HTTP-only deployments.
AUTH_COOKIE_SECURE=true
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=7

# Optional nginx Basic Auth as an additional perimeter control.
# This is no longer required; the UI has its own login page.
ADMIN_BASIC_AUTH=false
ADMIN_BASIC_USER=synapse-admin
ADMIN_BASIC_PASSWORD=
