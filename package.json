{
  "name": "recall",
  "version": "0.1.0",
  "description": "Centralized AI session knowledge base for engineering teams",
  "main": "dist/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build --workspaces --if-present",
    "build:core": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker-entry.js",
    "dev:worker": "tsx watch src/worker-entry.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings=0",
    "format": "prettier --write src tests",
    "migrate": "node scripts/migrate.mjs",
    "backfill:embeddings": "npm run build:core && node scripts/backfill-embeddings.mjs",
    "seed": "tsx src/scripts/seed.ts",
    "smoke:local": "node scripts/smoke-local.mjs",
    "load:retrieval": "node scripts/load-test.mjs",
    "test:concurrency": "vitest run tests/integration/processing-status-concurrency.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/swagger": "9.8.1",
    "bullmq": "5.81.2",
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "openai": "6.49.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "uuid": "14.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
